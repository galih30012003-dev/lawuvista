    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': 'https://lawuvista.com/villa-kemuning/#product',
    'name': 'Sewa Villa Kemuning View Gunung Lawu',
    'description': 'Penginapan villa nyaman berhawa sejuk di tengah kebun teh Kemuning dengan panorama langsung Gunung Lawu. Cocok untuk keluarga dan rombongan gathering.',
    'image': 'https://lawuvista.com/assets/images/villa-hero.webp',
    'brand': {
      '@type': 'Brand',
