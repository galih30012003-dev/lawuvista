---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faq?: FaqItem[];
  canonicalUrl?: string;
}

const {
  faq = [],
  canonicalUrl = 'https://lawuvista.com/'
} = Astro.props;

// Skema Organisasi / LocalBusiness Utama (Tanpa self-serving rating di homepage sesuai pedoman Google)
const businessSchema = {
