  '@type': ['TravelAgency', 'TouristInformationCenter', 'LocalBusiness'],
  '@id': 'https://lawuvista.com/#organization',
  'name': 'Lawu Vista Kemuning',
  'alternateName': 'Lawu Vista Jeep Adventure & Outbound Kemuning',
  'description': 'Pusat reservasi paket wisata & gathering terlengkap di Kemuning, Karanganyar: Jeep Adventure 4x4, River Tubing, Outbound Team Building & Villa pemandangan Gunung Lawu.',
  'url': 'https://lawuvista.com/',
  'telephone': '+6281228237512',
  'image': [
    'https://lawuvista.com/assets/images/og-default.jpg',
    'https://lawuvista.com/assets/images/hero-home.webp',
    'https://lawuvista.com/assets/images/jeep-hero.webp'
  ],
  'logo': 'https://lawuvista.com/assets/images/logos/logo.webp',
  'priceRange': 'Rp40.000 - Rp1.200.000',
  'currenciesAccepted': 'IDR',
  'paymentAccepted': 'Cash, Bank Transfer, QRIS',
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': 'Jl. Kemuning, Ngargoyoso',
    'addressLocality': 'Karanganyar',
    'addressRegion': 'Jawa Tengah',
    'postalCode': '57793',
    'addressCountry': 'ID'
  },
  'geo': {
    '@type': 'GeoCoordinates',
    'latitude': -7.6247,
    'longitude': 111.1308
  },
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      'opens': '07:00',
      'closes': '18:00'
    }
  ],
  'sameAs': [
    'https://wa.me/6281228237512'
  ]
};

// Skema Produk / Layanan Khusus Halaman Layanan (Agar Bintang Ulasan Muncul Resmi di Google SERP)
let serviceSchema: any = null;

