---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand & Alamat -->
      <div class="footer-brand">
        <a href="/" class="nav-logo" aria-label="Lawu Vista – Beranda">
          <img
            src="/assets/images/logos/logo.webp"
            alt="Lawu Vista"
            height="36"
            width="106"
            loading="lazy"
            decoding="async"
            class="logo-img"
          />
        </a>
        <p class="footer-tagline">
          Paket wisata dan gathering terlengkap di Kemuning, Karanganyar. Jeep Adventure, River Tubing, Outbound, dan Villa dengan pemandangan Gunung Lawu.
        </p>
        <address class="footer-address">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
          </svg>
          Kemuning, Ngargoyoso, Karanganyar, Jawa Tengah
        </address>
        <div class="footer-contacts">
          <a href="https://wa.me/6281228237512" class="footer-contact-link lv-wa-cta" target="_blank" rel="noopener">
            <svg class="wa-icon-svg" width="16" height="16" aria-hidden="true"><use href="#icon-wa"/></svg>
            +62 812-2823-7512
          </a>
        </div>
      </div>

      <!-- Layanan -->
      <div class="footer-col">
        <h4 class="footer-heading">Layanan Wisata</h4>
        <ul class="footer-links" role="list">
          <li><a href="/jeep-adventure-kemuning/">Jeep Adventure Kemuning</a></li>
          <li><a href="/river-tubing-kemuning/">River Tubing Kali Pucung</a></li>
          <li><a href="/outbound-kemuning/">Outbound &amp; Team Building</a></li>
          <li><a href="/villa-kemuning/">Villa Kemuning View Lawu</a></li>
        </ul>
      </div>

      <!-- Paket Bundling Hemat -->
      <div class="footer-col">
        <h4 class="footer-heading">Paket Bundling Hemat</h4>
        <ul class="footer-links" role="list">
          <li><a href="/jeep-adventure-kemuning/#bundles">Super Combo: Jeep + Tubing + Makan</a></li>
          <li><a href="/outbound-kemuning/#bundles">Corporate Retreat 2D1N Villa</a></li>
          <li><a href="/jeep-adventure-kemuning/#bundles">Family Adventure Ramah Anak</a></li>
          <li><a href="/jeep-adventure-kemuning/#packages">Jeep Sunrise Rute Candi Cetho</a></li>
        </ul>
      </div>

      <!-- Legal & Navigasi -->
      <div class="footer-col">
        <h4 class="footer-heading">Informasi &amp; Legal</h4>
        <ul class="footer-links" role="list">
          <li><a href="/privacy-policy/">Kebijakan Privasi</a></li>
          <li><a href="/syarat-ketentuan/">Syarat &amp; Ketentuan</a></li>
          <li><a href="/#faq">Pertanyaan Umum (FAQ)</a></li>
          <li><a href="/#keunggulan">Kenapa Lawu Vista?</a></li>
        </ul>
      </div>
    </div>

    <!-- Footer Bottom -->
    <div class="footer-bottom">
      <p>&copy; {currentYear} Lawu Vista Kemuning. Hak Cipta Dilindungi.</p>
      <div class="footer-credit">
        Pusat Wisata Kemuning &bull; Karanganyar &bull; Tawangmangu
      </div>
    </div>
  </div>
</footer>
