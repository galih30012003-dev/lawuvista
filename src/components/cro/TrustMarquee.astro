---
interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'DIPERCAYA OLEH',
  subtitle = 'Dari perusahaan besar hingga sekolah, semua memilih Lawu Vista untuk momen yang tak terlupakan.'
} = Astro.props;

const clientLogos = [
  { name: 'Telkom Indonesia', file: '/assets/images/logos/telkom-indonesia.webp' },
  { name: 'Bank BRI', file: '/assets/images/logos/bank-bri.webp' },
  { name: 'PKK', file: '/assets/images/logos/pkk.webp' },
  { name: 'SMK Tamansiswa', file: '/assets/images/logos/smk-tamansiswa.webp' },
  { name: 'SMPN 6 Pati', file: '/assets/images/logos/smpn-6-pati.webp' },
  { name: 'PT Hongya', file: '/assets/images/logos/pt-hongya.webp' },
  { name: 'Ardianajie Trans', file: '/assets/images/logos/ardianajie-trans.webp' },
  { name: 'Summitri Tours', file: '/assets/images/logos/summitri-tours.webp' },
  { name: 'Yayasan Dail Khairat', file: '/assets/images/logos/yayasan-dail-khairat.webp' }
];
---

<section class="trusted-section" aria-label="Dipercaya oleh berbagai instansi">
  <div class="container">
    <div class="trusted-header">
      <div class="trusted-label">{title}</div>
      <div class="trusted-subtitle">{subtitle}</div>
    </div>
  </div>
  <div class="trusted-marquee-wrapper" aria-hidden="true">
    <div class="trusted-marquee-track">
      {clientLogos.map(logo => (
        <div class="trusted-marquee-item">
          <img src={logo.file} alt={logo.name} loading="lazy" width="120" height="40" />
        </div>
      ))}
      <!-- Duplicate Track for Seamless Infinite Loop -->
      {clientLogos.map(logo => (
        <div class="trusted-marquee-item">
          <img src={logo.file} alt={logo.name} loading="lazy" width="120" height="40" />
        </div>
      ))}
    </div>
  </div>
</section>
