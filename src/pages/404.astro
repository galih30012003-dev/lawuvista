---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
---

<Layout
  title="Halaman Tidak Ditemukan (404) – Lawu Vista"
  description="Maaf, halaman yang Anda cari tidak ditemukan. Kembali ke beranda Lawu Vista untuk melihat paket wisata Kemuning."
  canonical="https://lawuvista.com/404.html"
>
  <Navbar />

  <main class="min-h-[75vh] flex items-center justify-center bg-gray-50 px-4 py-24 text-center">
    <div class="max-w-md mx-auto">
      <div class="text-7xl font-black text-primary/30 mb-2">404</div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-gray-900 mb-3">
        Oops! Halaman Tidak Ditemukan
      </h1>
      <p class="text-xs sm:text-sm text-gray-600 mb-8 leading-relaxed">
        Halaman yang Anda tuju mungkin sudah dipindahkan atau tautan salah ketik. Yuk kembali ke beranda untuk memilih petualangan seru Anda di Kemuning.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/"
          class="w-full sm:w-auto inline-flex items-center justify-center bg-primary hover:bg-primary-dark text-white font-bold px-6 py-3 rounded-xl shadow-lg shadow-primary/25 text-sm transition-all"
        >
          Kembali ke Beranda
        </a>
        <a
          href="https://wa.me/6281228237512"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center bg-wa hover:bg-wa-dark text-white font-bold px-6 py-3 rounded-xl shadow text-sm transition-all"
        >
          Chat Bantuan CS via WA
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
