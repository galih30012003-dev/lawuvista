---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import BundleCard from '@/components/cro/BundleCard.astro';
import TrustMarquee from '@/components/cro/TrustMarquee.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import packagesData from '@/data/packages.json';

const outboundPackages = packagesData.outbound;
const corporateRetreat = packagesData.bundles[1]; // Corporate Retreat 2D1N Villa
const superCombo = packagesData.bundles[0];

const faqB2B = [
  {
    question: 'Berapa minimal peserta untuk outbound atau gathering di Kemuning?',
    answer: 'Minimal peserta untuk paket outbound adalah 16–20 orang. Kami juga berpengalaman menangani gathering skala besar hingga 500+ peserta dengan master trainer berlisensi.'
  },
  {
    question: 'Apakah Lawu Vista menyediakan invoice dan kuitansi resmi berbadan usaha?',
    answer: 'Ya, tentu saja. Kami menyediakan kelengkapan administrasi resmi untuk kebutuhan LPJ perusahaan, termasuk invoice, kuitansi resmi bermaterai, dan kelengkapan NPWP untuk pelaporan keuangan instansi Anda.'
  },
  {
    question: 'Apakah tema games dan rundown acara dapat dikustomisasi sesuai tujuan perusahaan?',
    answer: 'Bisa 100%. Master Trainer kami akan berdiskusi dengan panitia/HRD Anda untuk merancang tema program outbound (Sinergi Tim, Leadership, Komunikasi Efektif, atau Fun Refreshment) agar sesuai dengan target instansi Anda.'
  },
  {
    question: 'Apakah paket sudah termasuk makan siang dan tempat transit?',
    answer: 'Ya, seluruh paket outbound sudah mencakup makan siang prasmanan khas tradisional pedesaan Kemuning, welcome drink & snack, pemakaian area resto transit beratap, sound system, dan toilet bersih.'
  }
];
---

<Layout
  title="Outbound Kemuning – Team Building &amp; Gathering | Lawu Vista"
  description="Outbound &amp; Team Building Kemuning profesional. Untuk corporate, sekolah &amp; komunitas. Mulai Rp90.000/orang, min 20 pax. Konsultasi gratis via WA!"
  canonical="https://lawuvista.com/outbound-kemuning/"
  ogImage="/assets/images/outbound-hero.webp"
>
  <JsonLd faq={faqB2B} canonicalUrl="https://lawuvista.com/outbound-kemuning/" />

  <!-- NAVBAR ASLI -->
  <Navbar transparent={true} />

  <!-- HERO SECTION ASLI OUTBOUND -->
  <section class="hero-section reveal" aria-labelledby="hero-heading">
    <div class="hero-bg">
      <img
        src="/assets/images/outbound-hero.webp"
        alt="Outbound Kemuning"
        class="hero-bg-img"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="1080"
        decoding="async"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="container hero-content">
      <div class="hero-badge">Vendor Outbound &amp; Gathering #1 Kemuning — Dipercaya Telkom, BRI, SMK &amp; 200+ Instansi</div>
      <h1 id="hero-heading" class="hero-title">Outbound &amp; Team Building Kemuning</h1>
      <p class="hero-subtitle">Solusi gathering &amp; team building all-in untuk perusahaan, BUMN, sekolah, &amp; instansi pemerintah! Didampingi Master Trainer bersertifikat, area resto transit luas &amp; privat, free dokumentasi foto/video/drone, serta legalitas lengkap (Invoice &amp; Kuitansi resmi). Draft proposal &amp; RAB siap dalam 15 menit via WhatsApp!</p>

      <div class="hero-proof">
        <div class="hero-avatars" aria-hidden="true">
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-1.webp" alt="Peserta" width="32" height="32" /></div>
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-2.webp" alt="Peserta" width="32" height="32" /></div>
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-3.webp" alt="Peserta" width="32" height="32" /></div>
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-4.webp" alt="Peserta" width="32" height="32" /></div>
        </div>
        <div>
          <div class="hero-stars" role="img" aria-label="Rating 5 bintang">
            <div class="stars">
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <span>5.0 (200+ Event Instansi)</span>
          </div>
          <div class="hero-proof-text">2.500+ Peserta Puas</div>
        </div>
      </div>

      <div class="hero-cta-group">
        <a
          href="https://wa.me/6281228237512?text=Halo%20Lawu%20Vista%2C%20saya%20ingin%20info%20Outbound%20Kemuning%20untuk%20rombongan%20kami.%20Bisa%20bantu%3F"
          class="btn btn-wa btn-lg lv-wa-cta"
          target="_blank"
          rel="noopener"
          data-package-id="hero-outbound-cta"
          data-default-msg="Halo Lawu Vista, saya ingin info Outbound Kemuning untuk rombongan kami. Bisa bantu?"
        >
          <svg class="wa-icon-svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.118 1.528 5.843L0 24l6.335-1.508A11.956 11.956 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.003-1.366l-.357-.214-3.762.895.954-3.667-.234-.375A9.776 9.776 0 012.182 12C2.182 6.574 6.574 2.182 12 2.182S21.818 6.574 21.818 12 21.818z"/></svg> Chat WhatsApp Sekarang
          <small>Respon cepat 08.00&ndash;20.00 WIB</small>
        </a>
        <a href="#corporate-bundles" class="btn btn-outline btn-lg">
          Paket All-in Corporate
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SCARCITY BAR ASLI -->
  <div class="scarcity-bar" role="alert">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span><strong>⚡ Jadwal Gathering Akhir Pekan Cepat Penuh:</strong> Booking slot instansi Anda minimal H-7 untuk memastikan ketersediaan venue transit privat, jadwal Master Trainer, &amp; konsumsi prasmanan.</span>
  </div>

  <!-- TRUST BAR ASLI -->
  <TrustMarquee />

  <!-- BUNDLING ALL-IN CORPORATE GATHERING -->
  <section id="corporate-bundles" class="section packages-section" style="background:#fdf4ff;border-top:1px solid #f0abfc;border-bottom:1px solid #f0abfc;">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label" style="background:var(--forest);color:#fff;padding:.3rem .9rem;border-radius:99px;">🏢 SOLUSI RETREAT & GATHERING ALL-IN</span>
        <h2 class="section-title">Paket Gathering Paling Praktis untuk Perusahaan</h2>
        <p class="section-subtitle">Semua sudah disiapkan dari venue, rundown, fasilitator, penginapan villa, hingga konsumsi prasmanan lengkap.</p>
      </div>

      <div class="packages-grid" style="max-width:960px;margin:0 auto;">
        {corporateRetreat && <BundleCard pkg={corporateRetreat as any} featured={true} />}
        {superCombo && <BundleCard pkg={superCombo as any} />}
      </div>
    </div>
  </section>

  <!-- KATALOG PAKET OUTBOUND LENGKAP DENGAN STYLING ASLI (JPKG-GRID) -->
  <section id="packages" class="section packages-section" aria-labelledby="packages-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">PILIH PAKET OUTBOUND</span>
        <h2 id="packages-heading" class="section-title">Katalog Lengkap Paket Outbound 1 s/d 8</h2>
        <p class="section-subtitle">Minimal peserta 16–20 orang. Sudah termasuk master trainer, fasilitator, tool games, makan prasmanan &amp; resto transit!</p>
      </div>

      <div class="jpkg-grid jpkg-grid-2 reveal">
        {outboundPackages.map(pkg => (
          <div class={`jpkg-card ${pkg.isPopular ? 'jpkg-card-popular' : ''}`}>
            {pkg.badge && <div class="jpkg-badge">{pkg.badge}</div>}
            <div class="jpkg-img">
              <img src={pkg.image} alt={pkg.name} loading="lazy" width="600" height="300" decoding="async" />
            </div>
            <div class="jpkg-header">
              <h3 class="jpkg-name">{pkg.name}</h3>
              <div class="jpkg-price">
                <span class="jpkg-price-amount">Rp{new Intl.NumberFormat('id-ID').format(pkg.priceAmount)}</span>
                <span class="jpkg-price-unit">{pkg.priceUnit}</span>
              </div>
              <div class="jpkg-price-note">Min. {pkg.minPax || 16} peserta</div>
            </div>
            <ul class="jpkg-routes">
              {pkg.features.map(f => (
                <li style="display:flex;align-items:flex-start;gap:.5rem;font-size:.85rem;color:#374151;line-height:1.4;padding:.15rem 0">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink:0;margin-top:2px;color:#16a34a"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <div class="jpkg-footer">
              <a
                href={`https://wa.me/6281228237512?text=${encodeURIComponent(pkg.waTemplate)}`}
                class="jpkg-btn jpkg-btn-wa lv-wa-cta"
                target="_blank"
                rel="noopener"
                data-package-id={pkg.id}
                data-default-msg={pkg.waTemplate}
              >
                <svg class="wa-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><use href="#icon-wa"/></svg> Minta Penawaran via WA
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS SECTION ASLI OUTBOUND -->
  <section class="section benefit-section" id="keunggulan">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">KENAPA 200+ INSTANSI MEMILIH LAWU VISTA?</span>
        <h2 class="section-title">Standar Layanan Profesional untuk Kesuksesan Event Perusahaan</h2>
      </div>
      <div class="benefit-grid benefit-grid-6 reveal">
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></div>
          <h3 class="benefit-title">Fasilitator Berlisensi</h3>
          <p class="benefit-desc">Trainer profesional berpengalaman merancang games yang membangun chemistry, leadership &amp; team bonding.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
          <h3 class="benefit-title">Venue Transit Luas</h3>
          <p class="benefit-desc">Area resto transit beratap, aula pertemuan, panggung, sound system lengkap, mushola &amp; toilet banyak.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg></div>
          <h3 class="benefit-title">Legalitas Resmi &amp; LPJ</h3>
          <p class="benefit-desc">Faktur resmi, invoice bermaterai, kelengkapan NPWP &amp; kuitansi berbadan usaha untuk pertanggungjawaban panitia/HRD.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg></div>
          <h3 class="benefit-title">Dokumentasi Foto &amp; Drone</h3>
          <p class="benefit-desc">Free liputan dokumentasi foto profesional, video cinematic, dan footage drone untuk publikasi media sosial instansi.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
          <h3 class="benefit-title">Kapasitas 500+ Pax</h3>
          <p class="benefit-desc">Berpengalaman mengelola ratusan peserta serentak dengan alur kegiatan terorganisir, aman, dan tepat waktu.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18v-6a9 9 0 0118 0v6"/><path d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z"/></svg></div>
          <h3 class="benefit-title">Proposal &amp; RAB Kilat</h3>
          <p class="benefit-desc">Butuh draft proposal &amp; RAB untuk diajukan ke pimpinan? Kami siapkan draft PDF resmi beserta rundown dalam 15 menit via WA!</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ B2B ASLI -->
  <section class="section faq-section" id="faq">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">FAQ SEPUTAR OUTBOUND</span>
        <h2 class="section-title">Pertanyaan Panitia &amp; HRD Perusahaan</h2>
      </div>
      <div class="faq-grid reveal">
        {faqB2B.map((item, idx) => (
          <div class="faq-item" id={`faq-outbound-${idx}`}>
            <button class="faq-question" aria-expanded="false" aria-controls={`faq-outbound-${idx}-ans`}>
              {item.question}
              <span class="faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span>
            </button>
            <div class="faq-answer" id={`faq-outbound-${idx}-ans`} role="region" aria-hidden="true">
              <p>{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA SECTION ASLI -->
  <section class="cta-section" id="cta">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-left">
          <h2>Rencanakan Event Kantor Anda<br />Bersama Lawu Vista Sekarang!</h2>
          <p>Dapatkan proposal penawaran resmi, contoh susunan acara (rundown), dan konsultasi penyesuaian anggaran secara gratis.</p>
        </div>
        <div class="cta-right">
          <div class="cta-right-icon" aria-hidden="true">
            <svg class="wa-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.118 1.528 5.843L0 24l6.335-1.508A11.956 11.956 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.003-1.366l-.357-.214-3.762.895.954-3.667-.234-.375A9.776 9.776 0 012.182 12C2.182 6.574 6.574 2.182 12 2.182S21.818 6.574 21.818 12 21.818z"/></svg>
          </div>
          <h3>Minta Proposal Resmi</h3>
          <p class="cta-hours">Respon cepat 08.00&ndash;20.00 WIB</p>
          <a
            href="https://wa.me/6281228237512?text=Halo%20Lawu%20Vista%2C%20kami%20dari%20instansi%2Fperusahaan%20ingin%20meminta%20proposal%20resmi%20paket%20outbound%20gathering."
            class="btn btn-wa btn-lg btn-block lv-wa-cta"
            target="_blank"
            rel="noopener"
            data-package-id="cta-bottom-outbound"
            data-default-msg="Halo Lawu Vista, kami dari instansi/perusahaan ingin meminta proposal resmi paket outbound gathering."
          >
            Minta Proposal via WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER ASLI -->
  <Footer />
</Layout>
