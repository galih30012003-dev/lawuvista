---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import BundleCard from '@/components/cro/BundleCard.astro';
import TrustMarquee from '@/components/cro/TrustMarquee.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import packagesData from '@/data/packages.json';

const tubingPackages = packagesData.tubing;
const superCombo = packagesData.bundles[0];

const faqTubing = [
  {
    question: 'Berapa usia minimal anak untuk ikut River Tubing Kemuning?',
    answer: 'Untuk rute santai Kali Pucung, anak usia mulai 5 tahun sudah dapat berpartisipasi dengan aman di bawah pengawasan pemandu dan perlengkapan life jacket ukuran khusus anak.'
  },
  {
    question: 'Apakah perlengkapan keselamatan (safety gear) sudah termasuk?',
    answer: 'Ya, seluruh peserta wajib dan sudah mendapatkan pelampung (life jacket), helm pelindung kepala, ban tubing berkualitas, serta pendampingan guide/tim rescue di setiap jeram.'
  },
  {
    question: 'Apakah ada tempat ganti baju, bilas dan toilet bersih?',
    answer: 'Tentu saja. Tempat transit kami memiliki kamar bilas air bersih dalam jumlah banyak, ruang ganti pakaian, toilet terawat, dan mushola yang nyaman.'
  },
  {
    question: 'Berapa lama durasi pengarungan River Tubing?',
    answer: 'Durasi pengarungan berkisar antara 30 hingga 60 menit tergantung rute yang dipilih (Short 800M, Medium 1KM, atau Long 1.3KM - 1.8KM).'
  }
];
---

<Layout
  title="River Tubing Kemuning – Arung Jeram Seru &amp; Aman | Lawu Vista"
  description="River Tubing Kemuning seru &amp; aman di Lawu Vista. Sungai jernih, pemandu berpengalaman. Mulai Rp40.000/orang. Cocok keluarga &amp; rombongan. Book sekarang!"
  canonical="https://lawuvista.com/river-tubing-kemuning/"
  ogImage="/assets/images/tubing-hero.webp"
>
  <JsonLd faq={faqTubing} canonicalUrl="https://lawuvista.com/river-tubing-kemuning/" />

  <!-- NAVBAR ASLI -->
  <Navbar transparent={true} />

  <!-- HERO SECTION ASLI RIVER TUBING -->
  <section class="hero-section reveal" aria-labelledby="hero-heading">
    <div class="hero-bg">
      <img
        src="/assets/images/tubing-hero.webp"
        alt="River Tubing Kemuning"
        class="hero-bg-img"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="1080"
        decoding="async"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="container hero-content">
      <div class="hero-badge">#1 River Tubing Kemuning — Terbukti 500+ Peserta Puas</div>
      <h1 id="hero-heading" class="hero-title">River Tubing Kemuning</h1>
      <p class="hero-subtitle">Basah-Basahan Seru di Sungai Jernih Kemuning — Dijamin Nagih! Perlengkapan Lengkap, Guide Bersertifikat, Harga All-In. Aman untuk Keluarga &amp; Anak-Anak. Slot Weekend Terbatas — Pesan Sekarang!</p>

      <div class="hero-proof">
        <div class="hero-avatars" aria-hidden="true">
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-1.webp" alt="Peserta" width="32" height="32" /></div>
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-2.webp" alt="Peserta" width="32" height="32" /></div>
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-3.webp" alt="Peserta" width="32" height="32" /></div>
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-4.webp" alt="Peserta" width="32" height="32" /></div>
        </div>
        <div>
          <div class="hero-stars" role="img" aria-label="Rating 5 bintang">
            <div class="stars">
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <span>5.0 (250+ Ulasan Puas)</span>
          </div>
          <div class="hero-proof-text">2.500+ Peserta Puas</div>
        </div>
      </div>

      <div class="hero-cta-group">
        <a
          href="https://wa.me/6281228237512?text=Halo%20Lawu%20Vista%2C%20saya%20ingin%20booking%20River%20Tubing%20Kemuning.%20Bisa%20info%20paket%20%26%20harga%3F"
          class="btn btn-wa btn-lg lv-wa-cta"
          target="_blank"
          rel="noopener"
          data-package-id="hero-tubing-cta"
          data-default-msg="Halo Lawu Vista, saya ingin booking River Tubing Kemuning. Bisa info paket & harga?"
        >
          <svg class="wa-icon-svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.118 1.528 5.843L0 24l6.335-1.508A11.956 11.956 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.003-1.366l-.357-.214-3.762.895.954-3.667-.234-.375A9.776 9.776 0 012.182 12C2.182 6.574 6.574 2.182 12 2.182S21.818 6.574 21.818 12 17.426 21.818 12 21.818z"/></svg> Chat WhatsApp Sekarang
          <small>Respon cepat 08.00&ndash;20.00 WIB</small>
        </a>
        <a href="#bundles" class="btn btn-outline btn-lg">
          Paket Hemat Bundling
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SCARCITY BAR ASLI -->
  <div class="scarcity-bar" role="alert">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg> Kapasitas terbatas per sesi! Segera amankan tempat untuk rombongan Anda.
  </div>

  <!-- TRUST BAR ASLI -->
  <TrustMarquee />

  <!-- UPSELL BUNDLING SUPER COMBO -->
  <section id="bundles" class="section packages-section" style="background:#fdf4ff;border-top:1px solid #f0abfc;border-bottom:1px solid #f0abfc;">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label" style="background:var(--primary);color:#fff;padding:.3rem .9rem;border-radius:99px;">⭐ REKOMENDASI PALING HEMAT</span>
        <h2 class="section-title">Mau Lebih Puas? Ambil Paket Bundling Super Combo!</h2>
        <p class="section-subtitle">Dapatkan pengalaman lengkap: Jeep Offroad + River Tubing + Makan Siang Prasmanan all-in hemat Rp65.000/orang!</p>
      </div>

      <div class="packages-grid" style="max-width:540px;margin:0 auto;">
        {superCombo && <BundleCard pkg={superCombo as any} featured={true} />}
      </div>
    </div>
  </section>

  <!-- KATALOG PAKET TUBING ASLI (JPKG-GRID) -->
  <section id="packages" class="section packages-section" aria-labelledby="packages-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">PILIH RUTE SUNGAI</span>
        <h2 id="packages-heading" class="section-title">Katalog Lengkap Rute River Tubing Kemuning</h2>
        <p class="section-subtitle">Peralatan pelampung, helm, ban, pemandu berpengalaman, dan dokumentasi foto/video sudah all-in!</p>
      </div>

      <div class="jpkg-grid jpkg-grid-2 reveal">
        {tubingPackages.map(pkg => (
          <div class={`jpkg-card ${pkg.isPopular ? 'jpkg-card-popular' : ''}`}>
            {pkg.badge && <div class="jpkg-badge">{pkg.badge}</div>}
            <div class="jpkg-img">
              <img src={pkg.image} alt={pkg.name} loading="lazy" width="600" height="300" decoding="async" />
            </div>
            <div class="jpkg-header">
              <h3 class="jpkg-name">{pkg.name}</h3>
              <div class="jpkg-price">
                <span class="jpkg-price-amount">Rp{new Intl.NumberFormat('id-ID').format(pkg.priceAmount)}</span>
                <span class="jpkg-price-unit">{pkg.priceUnit}</span>
              </div>
            </div>
            <ul class="jpkg-routes">
              {pkg.features.map(f => (
                <li style="display:flex;align-items:flex-start;gap:.5rem;font-size:.85rem;color:#374151;line-height:1.4;padding:.15rem 0">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink:0;margin-top:2px;color:#16a34a"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <div class="jpkg-footer">
              <a
                href={`https://wa.me/6281228237512?text=${encodeURIComponent(pkg.waTemplate)}`}
                class="jpkg-btn jpkg-btn-wa lv-wa-cta"
                target="_blank"
                rel="noopener"
                data-package-id={pkg.id}
                data-default-msg={pkg.waTemplate}
              >
                <svg class="wa-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><use href="#icon-wa"/></svg> Booking via WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS SECTION ASLI -->
  <section class="section benefits-section">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">KENAPA TUBING LAWU VISTA SANGAT AMAN?</span>
        <h2 class="section-title">Keselamatan dan Kenyamanan Keluarga Anda Adalah Prioritas Utama</h2>
      </div>
      <div class="benefits-grid reveal">
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
          <h3 class="benefit-title">Alat Safety Lengkap</h3>
          <p class="benefit-desc">Helm pelindung kepala tebal dan pelampung badan berstandar internasional untuk dewasa &amp; anak.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></div>
          <h3 class="benefit-title">River Guide Handal</h3>
          <p class="benefit-desc">Pemandu sungai berpengalaman siap mendampingi dan siaga di setiap titik jeram menantang.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
          <h3 class="benefit-title">Kamar Bilas Bersih</h3>
          <p class="benefit-desc">Tersedia kamar ganti dan tempat bilas air bersih dalam jumlah banyak, tidak perlu antre panjang.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg></div>
          <h3 class="benefit-title">Dokumentasi Gratis</h3>
          <p class="benefit-desc">Tim kami sigap mengambil foto &amp; video aksi basah-basahan Anda untuk kenang-kenangan seru!</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18v-6a9 9 0 0118 0v6"/><path d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z"/></svg></div>
          <h3 class="benefit-title">Respon WhatsApp Cepat</h3>
          <p class="benefit-desc">Dapatkan kepastian jadwal dan jam pengarungan dalam hitungan menit via chat WhatsApp resmi kami.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION ASLI -->
  <section class="section faq-section" id="faq">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">FAQ SEPUTAR RIVER TUBING</span>
        <h2 class="section-title">Pertanyaan yang Sering Diajukan</h2>
      </div>
      <div class="faq-grid reveal">
        {faqTubing.map((item, idx) => (
          <div class="faq-item" id={`faq-tubing-${idx}`}>
            <button class="faq-question" aria-expanded="false" aria-controls={`faq-tubing-${idx}-ans`}>
              {item.question}
              <span class="faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span>
            </button>
            <div class="faq-answer" id={`faq-tubing-${idx}-ans`} role="region" aria-hidden="true">
              <p>{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA SECTION ASLI -->
  <section class="cta-section" id="cta">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-left">
          <h2>Siap Basah-Basahan Seru<br />di River Tubing Kemuning?</h2>
          <p>Amankan slot jam pengarungan favorit rombongan Anda sekarang juga — tanpa antre panjang di lokasi!</p>
        </div>
        <div class="cta-right">
          <div class="cta-right-icon" aria-hidden="true">
            <svg class="wa-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.118 1.528 5.843L0 24l6.335-1.508A11.956 11.956 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.003-1.366l-.357-.214-3.762.895.954-3.667-.234-.375A9.776 9.776 0 012.182 12C2.182 6.574 6.574 2.182 12 2.182S21.818 6.574 21.818 12 21.818z"/></svg>
          </div>
          <h3>Booking Sekarang via WhatsApp</h3>
          <p class="cta-hours">Respon cepat 08.00&ndash;20.00 WIB</p>
          <a
            href="https://wa.me/6281228237512?text=Halo%20Lawu%20Vista%2C%20saya%20ingin%20booking%20River%20Tubing%20Kemuning.%20Bisa%20info%20paket%20%26%20harga%3F"
            class="btn btn-wa btn-lg btn-block lv-wa-cta"
            target="_blank"
            rel="noopener"
            data-package-id="cta-bottom-tubing"
            data-default-msg="Halo Lawu Vista, saya ingin booking River Tubing Kemuning. Bisa info paket & harga?"
          >
            Chat WhatsApp Sekarang
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER ASLI -->
  <Footer />
</Layout>
