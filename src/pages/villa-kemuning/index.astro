---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import BundleCard from '@/components/cro/BundleCard.astro';
import TrustMarquee from '@/components/cro/TrustMarquee.astro';
import OtherServices from '@/components/cro/OtherServices.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import packagesData from '@/data/packages.json';

const villaPackage = packagesData.villa[0];
const corporateRetreat = packagesData.bundles[1]; // Outbound + Villa 2D1N

const faqVilla = [
  {
    question: 'Berapa kapasitas maksimal tamu di Villa Lawu Vista?',
    answer: 'Villa kami sangat luas dan mampu menampung rombongan keluarga besar maupun tim kantor hingga 15–20 orang dengan area kamar yang lega dan terawat.'
  },
  {
    question: 'Apakah tersedia fasilitas dapur dan peralatan memasak?',
    answer: 'Ya, dapur dilengkapi dengan kompor, gas, peralatan memasak, piring, gelas, dispenser air minum, kulkas, serta area BBQ di halaman terbuka.'
  },
  {
    question: 'Apakah ada pemanas air (water heater) di kamar mandi?',
    answer: 'Mengingat udara Kemuning yang sangat sejuk, seluruh kamar mandi utama sudah dilengkapi dengan water heater air panas yang berfungsi optimal 24 jam.'
  },
  {
    question: 'Apakah lokasi villa dekat dengan wisata Jeep dan Kebun Teh?',
    answer: 'Sangat strategis! Villa Lawu Vista berlokasi di tengah kawasan kebun teh Kemuning, hanya 5–10 menit menuju titik start Jeep Adventure, River Tubing, dan cafe-cafe hits Kemuning.'
  }
];
---

<Layout
  title="Villa Kemuning – Sewa Villa View Gunung Lawu | Lawu Vista"
  description="Sewa Villa Kemuning Karanganyar dengan pemandangan Gunung Lawu langsung dari kamar. Fasilitas lengkap, kamar bersih, WiFi, BBQ area. Cek ketersediaan via WA!"
  canonical="https://lawuvista.com/villa-kemuning/"
  ogImage="/assets/images/villa-hero.webp"
>
  <JsonLd faq={faqVilla} canonicalUrl="https://lawuvista.com/villa-kemuning/" />

  <!-- NAVBAR ASLI -->
  <Navbar transparent={true} />

  <!-- HERO SECTION ASLI VILLA -->
  <section class="hero-section reveal" aria-labelledby="hero-heading">
    <div class="hero-bg">
      <img
        src="/assets/images/villa-hero.webp"
        alt="Villa Kemuning View Gunung Lawu"
        class="hero-bg-img"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="1080"
        decoding="async"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="container hero-content">
      <div class="hero-badge">Sewa Villa Kemuning Karanganyar</div>
      <h1 id="hero-heading" class="hero-title">Sewa Villa Kemuning View Gunung Lawu</h1>
      <p class="hero-subtitle">Penginapan berhawa sejuk di perkebunan teh Kemuning dengan panorama Gunung Lawu dari balkon. Berkapasitas 15 hingga 20 orang, dilengkapi dapur memasak, pemanas air, area BBQ luar ruangan, dan halaman parkir luas.</p>

      <div class="hero-proof">
        <div class="hero-avatars" aria-hidden="true">
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-1.webp" alt="Peserta" width="32" height="32" /></div>
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-2.webp" alt="Peserta" width="32" height="32" /></div>
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-3.webp" alt="Peserta" width="32" height="32" /></div>
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-4.webp" alt="Peserta" width="32" height="32" /></div>
        </div>
        <div>
          <div class="hero-stars" role="img" aria-label="Rating 5 bintang">
            <div class="stars">
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <span>5.0 (250+ Tamu Puas)</span>
          </div>
          <div class="hero-proof-text">2.500+ Tamu Puas</div>
        </div>
      </div>

      <div class="hero-cta-group">
        <a
          href="https://wa.me/6281228237512?text=Halo%20Lawu%20Vista%2C%20saya%20ingin%20booking%20Villa%20Kemuning.%20Bisa%20info%20ketersediaan%20%26%20harga%3F"
          class="btn btn-wa btn-lg lv-wa-cta"
          target="_blank"
          rel="noopener"
          data-package-id="hero-villa-cta"
          data-default-msg="Halo Lawu Vista, saya ingin booking Villa Kemuning. Bisa info ketersediaan & harga?"
        >
          <svg class="wa-icon-svg" width="22" height="22" aria-hidden="true"><use href="#icon-wa"/></svg> Cek Ketersediaan via WhatsApp
          <small>Tanya ketersediaan tanggal menginap</small>
        </a>
        <a href="#packages" class="btn btn-outline btn-lg">
          Fasilitas &amp; Tarif
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SCARCITY BAR ASLI -->
  <div class="scarcity-bar" role="alert">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span>Pemesanan villa untuk rombongan keluarga atau kantor disarankan reservasi lebih awal, terutama pada musim liburan dan akhir pekan.</span>
  </div>

  <!-- TRUST BAR ASLI -->
  <TrustMarquee />

  <!-- KATALOG PAKET VILLA DENGAN STYLING ASLI -->
  <section id="packages" class="section packages-section" aria-labelledby="packages-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Pilihan Menginap</span>
        <h2 id="packages-heading" class="section-title">Tarif Sewa Villa Kemuning</h2>
        <p class="section-subtitle">Kapasitas 15 sampai 20 orang dengan fasilitas rumah lengkap.</p>
      </div>

      <div class="packages-grid packages-grid-1 reveal" style="max-width:480px;margin:0 auto 3rem;">
        <div class="package-card package-popular">
          <div class="package-header">
            <h3 class="package-name">{villaPackage.name}</h3>
            <div class="package-price">
              <span class="price-amount">Rp{new Intl.NumberFormat('id-ID').format(villaPackage.priceAmount)}</span>
              <span class="price-unit">{villaPackage.priceUnit}</span>
            </div>
          </div>
          <ul class="package-features" role="list">
            {villaPackage.features.map(f => (
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                {f}
              </li>
            ))}
          </ul>
          <a
            href={`https://wa.me/6281228237512?text=${encodeURIComponent(villaPackage.waTemplate)}`}
            class="btn btn-wa btn-block lv-wa-cta"
            target="_blank"
            rel="noopener"
            data-package-id={villaPackage.id}
            data-default-msg={villaPackage.waTemplate}
          >
            <svg class="wa-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><use href="#icon-wa"/></svg> Cek Ketersediaan Tanggal
          </a>
        </div>
      </div>

      <!-- UPSELL BUNDLING VILLA RETREAT 2D1N -->
      {corporateRetreat && (
        <div class="reveal" style="max-width:540px;margin:2rem auto 0;text-align:center;">
          <span class="section-label" style="background:var(--forest);color:#fff;padding:.3rem .9rem;border-radius:99px;margin-bottom:1rem;">Paket Rombongan Komplit (2D1N)</span>
          <h3 style="font-size:1.25rem;font-weight:800;color:var(--gray-900);margin-bottom:1.5rem;">Sewa Villa Lengkap dengan Outbound &amp; Jeep</h3>
          <BundleCard pkg={corporateRetreat as any} featured={true} />
        </div>
      )}
    </div>
  </section>

  <!-- BENEFITS SECTION ASLI VILLA -->
  <section class="section benefit-section" id="keunggulan">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">Fasilitas Villa</span>
        <h2 class="section-title">Kenyamanan dan Fasilitas yang Tersedia</h2>
      </div>
      <div class="benefit-grid reveal">
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></div>
          <h3 class="benefit-title">Kamar Nyaman &amp; Bersih</h3>
          <p class="benefit-desc">Kamar tidur rapi dan terawat, ruang kumpul keluarga lega, serta pemandangan kebun teh dari teras villa.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg></div>
          <h3 class="benefit-title">Tarif Ramah Rombongan</h3>
          <p class="benefit-desc">Tarif per malam terjangkau untuk rombongan keluarga besar atau kegiatan kumpul kantor hingga 20 orang.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg></div>
          <h3 class="benefit-title">Fasilitas Rumah Lengkap</h3>
          <p class="benefit-desc">Dilengkapi akses WiFi, dapur memasak dan peralatan makan, area BBQ luar ruangan, dan pemanas air mandi.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
          <h3 class="benefit-title">Dekat Destinasi Wisata</h3>
          <p class="benefit-desc">Akses dekat menuju kebun teh, titik kumpul jeep adventure, lokasi river tubing, dan warung makan lokal Kemuning.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18v-6a9 9 0 0118 0v6"/><path d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z"/></svg></div>
          <h3 class="benefit-title">Respon Cepat</h3>
          <p class="benefit-desc">Cek ketersediaan real-time via WhatsApp — dibalas &lt;5 menit, langsung tahu tanggal kosong &amp; harganya.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION ANTAR-HALAMAN (CROSS-SELLING LAYANAN LAINNYA) -->
  <OtherServices currentService="villa" />

  <!-- FAQ SECTION ASLI VILLA -->
  <section class="section faq-section" id="faq">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">FAQ SEPUTAR VILLA</span>
        <h2 class="section-title">Pertanyaan yang Sering Diajukan</h2>
      </div>
      <div class="faq-grid reveal">
        {faqVilla.map((item, idx) => (
          <div class="faq-item" id={`faq-villa-${idx}`}>
            <button class="faq-question" aria-expanded="false" aria-controls={`faq-villa-${idx}-ans`}>
              {item.question}
              <span class="faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span>
            </button>
            <div class="faq-answer" id={`faq-villa-${idx}-ans`} role="region" aria-hidden="true">
              <p>{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA SECTION ASLI -->
  <section class="cta-section" id="cta">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-left">
          <h2>Nikmati Udara Sejuk Kemuning<br />di Villa Lawu Vista</h2>
          <p>Tanggal favorit akhir pekan dan libur panjang cepat terisi. Hubungi kami sekarang untuk cek ketersediaan kamar, request fasilitas BBQ, atau custom paket menginap rombongan Anda!</p>
        </div>
        <div class="cta-right">
          <div class="cta-right-icon" aria-hidden="true">
            <svg class="wa-icon-svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.118 1.528 5.843L0 24l6.335-1.508A11.956 11.956 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.003-1.366l-.357-.214-3.762.895.954-3.667-.234-.375A9.776 9.776 0 012.182 12C2.182 6.574 6.574 2.182 12 2.182S21.818 6.574 21.818 12 17.426 21.818 12 21.818z"/></svg>
          </div>
          <h3>Cek Tanggal Kosong via WhatsApp</h3>
          <p class="cta-hours">Respon cepat &lt;5 menit (08.00&ndash;20.00 WIB)</p>
          <a
            href="https://wa.me/6281228237512?text=Halo%20Lawu%20Vista%2C%20saya%20ingin%20booking%20Villa%20Kemuning.%20Bisa%20info%20ketersediaan%20%26%20harga%3F"
            class="btn btn-wa btn-lg btn-block lv-wa-cta"
            target="_blank"
            rel="noopener"
            data-package-id="cta-bottom-villa"
            data-default-msg="Halo Lawu Vista, saya ingin booking Villa Kemuning. Bisa info ketersediaan & harga?"
          >
            Kunci Tanggal Menginap Sekarang
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER ASLI -->
  <Footer />
</Layout>
