---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/layout/Navbar.astro';
import Footer from '@/components/layout/Footer.astro';
import BundleCard from '@/components/cro/BundleCard.astro';
import PaxCalculator from '@/components/cro/PaxCalculator.astro';
import TrustMarquee from '@/components/cro/TrustMarquee.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import packagesData from '@/data/packages.json';

const jeepPackages = packagesData.jeep;
const superCombo = packagesData.bundles[0];
const familyFun = packagesData.bundles[2];

const shortPackages = jeepPackages.filter(p => p.id.startsWith('jeep-short-') && !p.id.includes('plus'));
const shortPlusPackages = jeepPackages.filter(p => p.id.includes('plus'));
const mediumPackages = jeepPackages.filter(p => p.id.startsWith('jeep-medium-'));
const longPackages = jeepPackages.filter(p => p.id.startsWith('jeep-long-'));

const faqJeep = [
  {
    question: 'Berapa kapasitas 1 unit Jeep Adventure di Kemuning?',
    answer: 'Kapasitas standar setiap unit mobil jeep adalah 4 hingga 5 orang dewasa, demi kenyamanan dan keamanan selama melintasi rute offroad perkebunan teh.'
  },
  {
    question: 'Apakah rute Jeep Adventure aman untuk anak-anak dan lansia?',
    answer: 'Sangat aman! Kami memiliki pilihan rute santai (Short Route / Fun Tour) yang ramah anak dan lansia dengan pemandangan kebun teh, air terjun, dan spot foto asri tanpa medan yang terlalu ekstrem.'
  },
  {
    question: 'Apakah sudah termasuk tiket masuk wisata dan dokumentasi?',
    answer: 'Ya, seluruh paket jeep sudah mencakup driver berpengalaman, bahan bakar (BBM), serta dokumentasi foto dan video selama petualangan berlangsung.'
  },
  {
    question: 'Bagaimana cara booking Jeep Adventure di Lawu Vista?',
    answer: 'Cukup klik tombol WhatsApp, sebutkan tanggal rencana kunjungan, jumlah rombongan, dan paket yang diinginkan. Tim kami akan mengonfirmasi ketersediaan armada dalam waktu kurang dari 5 menit.'
  }
];
---

<Layout
  title="Jeep Adventure Kemuning – Sewa Jeep 4x4 | Lawu Vista"
  description="Jeep Adventure Kemuning bersama Lawu Vista. Jelajahi kebun teh & lereng Gunung Lawu. Harga mulai Rp300.000/jeep, muat 4-5 orang. Booking WA sekarang!"
  canonical="https://lawuvista.com/jeep-adventure-kemuning/"
  ogImage="/assets/images/jeep-hero.webp"
>
  <JsonLd faq={faqJeep} canonicalUrl="https://lawuvista.com/jeep-adventure-kemuning/" />

  <!-- NAVBAR ASLI -->
  <Navbar transparent={true} />

  <!-- HERO SECTION ASLI -->
  <section class="hero-section reveal" aria-labelledby="hero-heading">
    <div class="hero-bg">
      <img
        src="/assets/images/jeep-hero.webp"
        alt="Jeep Adventure Kemuning"
        class="hero-bg-img"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="1080"
        decoding="async"
      />
      <div class="hero-overlay"></div>
    </div>
    <div class="container hero-content">
      <div class="hero-badge">#1 Jeep Adventure Kemuning — 300+ Trip, Ribuan Peserta Puas</div>
      <h1 id="hero-heading" class="hero-title">Jeep Adventure Kemuning</h1>
      <p class="hero-subtitle">Jelajahi kebun teh Kemuning &amp; lereng Gunung Lawu naik Jeep 4x4 terbaik! <strong>Paket All-in Jujur:</strong> Driver Lokal Berlisensi, BBM, Tiket Masuk Wisata, Asuransi Resmi, &amp; Free Dokumentasi Foto/Video. Slot armada weekend terbatas — amankan sebelum H-3!</p>
      <div class="hero-proof">
        <div class="hero-avatars" aria-hidden="true">
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-1.webp" alt="Peserta" width="32" height="32" /></div>
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-2.webp" alt="Peserta" width="32" height="32" /></div>
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-3.webp" alt="Peserta" width="32" height="32" /></div>
          <div class="avatar-circle"><img src="/assets/images/avatars/avatar-4.webp" alt="Peserta" width="32" height="32" /></div>
        </div>
        <div>
          <div class="hero-stars" role="img" aria-label="Rating 5 bintang">
            <div class="stars">
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <svg viewBox="0 0 24 24" style="fill:#f59e0b;width:16px;height:16px" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            </div>
            <span>5.0 (250+ Ulasan Puas)</span>
          </div>
          <div class="hero-proof-text">2.500+ Peserta Puas</div>
        </div>
      </div>
      <div class="hero-cta-group">
        <a
          href="https://wa.me/6281228237512?text=Halo%20Lawu%20Vista%2C%20saya%20ingin%20booking%20Jeep%20Adventure%20Kemuning.%20Bisa%20info%20paket%20%26%20harga%3F"
          class="btn btn-wa btn-lg lv-wa-cta"
          target="_blank"
          rel="noopener"
          data-package-id="hero-jeep-cta"
          data-default-msg="Halo Lawu Vista, saya ingin booking Jeep Adventure Kemuning. Bisa info paket & harga?"
        >
          <svg class="wa-icon-svg" width="22" height="22" aria-hidden="true"><use href="#icon-wa"/></svg> Chat WhatsApp Sekarang
          <small>Respon cepat 08.00&ndash;20.00 WIB</small>
        </a>
        <a href="#bundles" class="btn btn-outline btn-lg">
          Paket Hemat Bundling
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SCARCITY BAR ASLI -->
  <div class="scarcity-bar" role="alert">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <span><strong>⚡ Slot Weekend Terbatas:</strong> Amankan armada Jeep Anda sebelum H-3! Kuota driver berlisensi terbatas setiap harinya demi standar kenyamanan &amp; keselamatan maksimal.</span>
  </div>

  <!-- TRUST BAR ASLI -->
  <TrustMarquee />

  <!-- SECTION BUNDLING JUARA & CALCULATOR (FITUR CRO BARU BERIKAN VALUE MAKSIMAL) -->
  <section id="bundles" class="section packages-section" style="background:#fdf4ff;border-top:1px solid #f0abfc;border-bottom:1px solid #f0abfc;">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label" style="background:var(--primary);color:#fff;padding:.3rem .9rem;border-radius:99px;">⭐ REKOMENDASI PALING HEMAT (BEST VALUE)</span>
        <h2 class="section-title">Paket Bundling Super Combo: Jeep + Tubing + Makan</h2>
        <p class="section-subtitle">Pilihan all-in terfavorit keluarga &amp; rombongan — hemat biaya hingga Rp65.000/orang dibanding beli terpisah!</p>
      </div>

      <div class="packages-grid" style="max-width:960px;margin:0 auto 2.5rem;">
        {superCombo && <BundleCard pkg={superCombo as any} featured={true} />}
        {familyFun && <BundleCard pkg={familyFun as any} />}
      </div>

      <!-- Pax Calculator Interaktif -->
      <PaxCalculator pricePerPax={195000} bundleName="Super Combo (Jeep + Tubing + Makan)" />
    </div>
  </section>

  <!-- KATALOG PAKET JEEP DENGAN STYLING ASLI (JPKG-GRID & JPKG-CARD) -->
  <section id="packages" class="section packages-section" aria-labelledby="packages-heading">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">PILIH RUTE JEEP</span>
        <h2 id="packages-heading" class="section-title">Katalog Lengkap Rute Jeep Adventure Kemuning</h2>
        <p class="section-subtitle">Harga per mobil jeep (kapasitas 4–5 orang). Driver profesional, BBM &amp; dokumentasi foto video sudah all-in!</p>
      </div>

      <!-- 1. GROUP SHORT -->
      <div class="reveal" style="text-align:left;margin:2rem 0 1.25rem">
        <span class="jpkg-group-label">PAKET SHORT ROUTE</span>
      </div>
      <div class="jpkg-grid jpkg-grid-3 reveal">
        {shortPackages.map(pkg => (
          <div class="jpkg-card">
            <div class="jpkg-img">
              <img src={pkg.image} alt={pkg.name} loading="lazy" width="600" height="300" decoding="async" />
            </div>
            <div class="jpkg-header">
              <h3 class="jpkg-name">{pkg.name}</h3>
              <div class="jpkg-price">
                <span class="jpkg-price-amount">Rp{new Intl.NumberFormat('id-ID').format(pkg.priceAmount)}</span>
                <span class="jpkg-price-unit">{pkg.priceUnit}</span>
              </div>
            </div>
            <ul class="jpkg-routes">
              {pkg.features.map(f => (
                <li style="display:flex;align-items:flex-start;gap:.5rem;font-size:.85rem;color:#374151;line-height:1.4;padding:.15rem 0">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink:0;margin-top:2px;color:#16a34a"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <div class="jpkg-footer">
              <a
                href={`https://wa.me/6281228237512?text=${encodeURIComponent(pkg.waTemplate)}`}
                class="jpkg-btn jpkg-btn-wa lv-wa-cta"
                target="_blank"
                rel="noopener"
                data-package-id={pkg.id}
                data-default-msg={pkg.waTemplate}
              >
                <svg class="wa-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><use href="#icon-wa"/></svg> Booking via WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- 2. GROUP SHORT PLUS -->
      <div class="reveal" style="text-align:left;margin:3rem 0 1.25rem">
        <span class="jpkg-group-label">PAKET SHORT PLUS</span>
      </div>
      <div class="jpkg-grid jpkg-grid-2 reveal">
        {shortPlusPackages.map(pkg => (
          <div class={`jpkg-card ${pkg.isPopular ? 'jpkg-card-popular' : ''}`}>
            {pkg.badge && <div class="jpkg-badge">{pkg.badge}</div>}
            <div class="jpkg-img">
              <img src={pkg.image} alt={pkg.name} loading="lazy" width="600" height="300" decoding="async" />
            </div>
            <div class="jpkg-header">
              <h3 class="jpkg-name">{pkg.name}</h3>
              <div class="jpkg-price">
                <span class="jpkg-price-amount">Rp{new Intl.NumberFormat('id-ID').format(pkg.priceAmount)}</span>
                <span class="jpkg-price-unit">{pkg.priceUnit}</span>
              </div>
            </div>
            <ul class="jpkg-routes">
              {pkg.features.map(f => (
                <li style="display:flex;align-items:flex-start;gap:.5rem;font-size:.85rem;color:#374151;line-height:1.4;padding:.15rem 0">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink:0;margin-top:2px;color:#16a34a"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <div class="jpkg-footer">
              <a
                href={`https://wa.me/6281228237512?text=${encodeURIComponent(pkg.waTemplate)}`}
                class="jpkg-btn jpkg-btn-wa lv-wa-cta"
                target="_blank"
                rel="noopener"
                data-package-id={pkg.id}
                data-default-msg={pkg.waTemplate}
              >
                <svg class="wa-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><use href="#icon-wa"/></svg> Booking via WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- 3. GROUP MEDIUM -->
      <div class="reveal" style="text-align:left;margin:3rem 0 1.25rem">
        <span class="jpkg-group-label">PAKET MEDIUM</span>
      </div>
      <div class="jpkg-grid jpkg-grid-2 reveal">
        {mediumPackages.map(pkg => (
          <div class="jpkg-card">
            <div class="jpkg-img">
              <img src={pkg.image} alt={pkg.name} loading="lazy" width="600" height="300" decoding="async" />
            </div>
            <div class="jpkg-header">
              <h3 class="jpkg-name">{pkg.name}</h3>
              <div class="jpkg-price">
                <span class="jpkg-price-amount">Rp{new Intl.NumberFormat('id-ID').format(pkg.priceAmount)}</span>
                <span class="jpkg-price-unit">{pkg.priceUnit}</span>
              </div>
            </div>
            <ul class="jpkg-routes">
              {pkg.features.map(f => (
                <li style="display:flex;align-items:flex-start;gap:.5rem;font-size:.85rem;color:#374151;line-height:1.4;padding:.15rem 0">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink:0;margin-top:2px;color:#16a34a"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <div class="jpkg-footer">
              <a
                href={`https://wa.me/6281228237512?text=${encodeURIComponent(pkg.waTemplate)}`}
                class="jpkg-btn jpkg-btn-wa lv-wa-cta"
                target="_blank"
                rel="noopener"
                data-package-id={pkg.id}
                data-default-msg={pkg.waTemplate}
              >
                <svg class="wa-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><use href="#icon-wa"/></svg> Booking via WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- 4. GROUP LONG -->
      <div class="reveal" style="text-align:left;margin:3rem 0 1.25rem">
        <span class="jpkg-group-label">PAKET LONG</span>
      </div>
      <div class="jpkg-grid jpkg-grid-2 reveal">
        {longPackages.map(pkg => (
          <div class={`jpkg-card ${pkg.isPopular ? 'jpkg-card-popular' : ''}`}>
            {pkg.badge && <div class="jpkg-badge">{pkg.badge}</div>}
            <div class="jpkg-img">
              <img src={pkg.image} alt={pkg.name} loading="lazy" width="600" height="300" decoding="async" />
            </div>
            <div class="jpkg-header">
              <h3 class="jpkg-name">{pkg.name}</h3>
              <div class="jpkg-price">
                <span class="jpkg-price-amount">Rp{new Intl.NumberFormat('id-ID').format(pkg.priceAmount)}</span>
                <span class="jpkg-price-unit">{pkg.priceUnit}</span>
              </div>
            </div>
            <ul class="jpkg-routes">
              {pkg.features.map(f => (
                <li style="display:flex;align-items:flex-start;gap:.5rem;font-size:.85rem;color:#374151;line-height:1.4;padding:.15rem 0">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="flex-shrink:0;margin-top:2px;color:#16a34a"><polyline points="20 6 9 17 4 12"/></svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <div class="jpkg-footer">
              <a
                href={`https://wa.me/6281228237512?text=${encodeURIComponent(pkg.waTemplate)}`}
                class="jpkg-btn jpkg-btn-wa lv-wa-cta"
                target="_blank"
                rel="noopener"
                data-package-id={pkg.id}
                data-default-msg={pkg.waTemplate}
              >
                <svg class="wa-icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><use href="#icon-wa"/></svg> Booking via WhatsApp
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- BENEFITS SECTION ASLI -->
  <section class="section benefit-section" id="keunggulan">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">KENAPA JEEP LAWU VISTA SELALU HABIS DI WEEKEND?</span>
        <h2 class="section-title">5 Alasan Peserta Setia Kami Tidak Pernah Pindah ke Lain Hati</h2>
      </div>
      <div class="benefit-grid reveal">
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></div>
          <h3 class="benefit-title">Driver Berlisensi &amp; Ramah</h3>
          <p class="benefit-desc">Driver lokal tersertifikasi, berpengalaman 5+ tahun melintasi kebun teh, ramah anak &amp; keluarga, mengutamakan kenyamanan Anda.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg></div>
          <h3 class="benefit-title">All-in Termasuk Asuransi</h3>
          <p class="benefit-desc">Harga transparan tanpa biaya siluman. Sudah termasuk BBM, tiket spot wisata, driver profesional, &amp; asuransi resmi!</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg></div>
          <h3 class="benefit-title">Garansi Armada Prima</h3>
          <p class="benefit-desc">Jeep 4x4 lolos inspeksi berkala, bersih, &amp; wangi. Jika ada kendala teknis, kami garansi penggantian armada langsung di tempat.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div>
          <h3 class="benefit-title">Aman untuk Semua Usia</h3>
          <p class="benefit-desc">Standar keselamatan ketat, seatbelt aktif, briefing rute sebelum jalan. Sangat aman dinikmati anak-anak hingga lansia.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18v-6a9 9 0 0118 0v6"/><path d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z"/></svg></div>
          <h3 class="benefit-title">Respon Super Cepat</h3>
          <p class="benefit-desc">Tanya kapan saja via WhatsApp — CS kami merespon dalam hitungan menit untuk mengamankan slot trip rombongan Anda.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION ASLI -->
  <section class="section faq-section" id="faq">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-label">FAQ SEPUTAR JEEP</span>
        <h2 class="section-title">Pertanyaan yang Sering Diajukan</h2>
      </div>
      <div class="faq-grid reveal">
        {faqJeep.map((item, idx) => (
          <div class="faq-item" id={`faq-jeep-${idx}`}>
            <button class="faq-question" aria-expanded="false" aria-controls={`faq-jeep-${idx}-ans`}>
              {item.question}
              <span class="faq-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg></span>
            </button>
            <div class="faq-answer" id={`faq-jeep-${idx}-ans`} role="region" aria-hidden="true">
              <p>{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA SECTION ASLI -->
  <section class="cta-section" id="cta">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-left">
          <h2>Siap Menaklukkan Kemuning<br />Bersama Jeep Lawu Vista?</h2>
